# ==============================================================================
# Configuración del Entorno - Huevo Real
# Duplica este archivo como '.env' y ajusta las variables para tu entorno.
# ==============================================================================

# Seguridad de Django
SECRET_KEY=django-insecure-your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,0.0.0.0

# Proveedores de Mapas (Opcionales)
# Por defecto el sistema utiliza Esri World Street Map y OSM Humanitario (gratuitos, sin API key).
# Si deseas activar capas comerciales opcionales, coloca tus claves aquí:
MAPBOX_ACCESS_TOKEN=
CARTO_API_KEY=
